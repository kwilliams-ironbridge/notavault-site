{
  "expo": {
    "name": "FourCount",
    "slug": "fourcount",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fourcount",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0e1116",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ironbridge.fourcount",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0e1116"
        }
      ],
      "expo-sqlite",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
